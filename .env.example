# Copy this file to .env and fill in real values. .env is git-ignored — never commit real secrets.
# See src/lib/env.ts for the validated schema and README.md's "Environment" table for what each key does.

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5433/sabeel_dev"

# Public origin of this deployment. Used for CSRF checks and cookie flags — must match exactly,
# including the scheme (https:// in production).
APP_ORIGIN="http://localhost:3020"

# HMAC key for hashing one-time codes. Generate 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OTP_PEPPER=""

# AES-256-GCM key for field-level encryption (national ID numbers). Must be exactly 32 random
# bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every previously-encrypted value unreadable — treat it like a password.
DATA_KEY=""

# SMS provider. Only "console" exists today (prints codes to the server log; refused when
# NODE_ENV=production — see src/lib/sms.ts). Write a real provider adapter before the pilot.
SMS_PROVIDER="console"

# Private folder for uploaded documents/photos/receipts — never served from /public.
STORAGE_DIR="./storage/private"

# First super-admin created by `npm run db:seed`. The seed refuses this placeholder number when
# NODE_ENV=production — replace it with the real owner's mobile before deploying.
SEED_SUPERADMIN_MOBILE="+966500000001"
SEED_SUPERADMIN_NAME="Super Admin"

# Set to "false" to disable the in-process background job loop (src/instrumentation.ts) — e.g. when
# running several app instances behind a load balancer and one dedicated process runs the jobs instead.
# JOBS_ENABLED="true"

NODE_ENV="development"
